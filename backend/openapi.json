          }
        }
      }
    },
    "/v1/analyses": {
      "post": {
        "summary": "Submit Analysis",
        "operationId": "submit_analysis_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",

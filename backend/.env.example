# Copy to .env for local development. Never commit a real .env file.
APP_NAME=Trend Detective Backend
APP_VERSION=0.1.0
APP_ENV=development
MOCK_MODE=false
API_PREFIX=/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Guardrails (defaults are fine for the demo)
MAX_VARIABLES_PER_ANALYSIS=4
MIN_PERIOD_MONTHS=12
MAX_PERIOD_MONTHS=600
MIN_AOI_SPAN_DEGREES=0.25
MAX_AOI_SPAN_DEGREES=40.0
MAX_QUESTION_LENGTH=500
MAX_COMPARISON_CELLS=4
MIN_SPIN_WINDOW_YEARS=3
MAX_SPIN_WINDOWS=60

# Mock job behaviour: true = complete inline, false = stay queued until advanced
MOCK_AUTO_COMPLETE_JOBS=true

# Documentation questions work without Gemini using local source excerpts.
RAG_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# Optional durable SQL repositories and separate worker (provision schema first).
# DATABASE_URL=
# JOB_BACKEND=database
# DATABASE_AUTO_CREATE=false

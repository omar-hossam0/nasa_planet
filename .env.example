# Role 04 LLM provider configuration (copy to .env; never commit .env)
# Keys are loaded server-side only. Missing keys MUST NOT block retrieval,
# validation, offline fallback or deterministic template tests (AGENT_BRIEF 6).

# Configured provider (14 Nov 2026): Google Gemini via Google AI Studio.
# Provider remains configurable; no provider/model superiority is assumed.
LLM_PROVIDER=gemini

# Server-side secret. Leave empty to run in keyless local_retrieval mode.
GEMINI_API_KEY=

# Model identifier to verify against official Google documentation at
# implementation time (AGENT_BRIEF 6).
LLM_MODEL=gemini-2.5-flash

# Bounded request timeout in seconds; timeout/invalid JSON/validation failure
# triggers a bounded retry or deterministic local fallback.
LLM_TIMEOUT_SECONDS=8

# Maximum retries before deterministic local fallback.
LLM_MAX_RETRIES=1

# --- Optional legacy fallback (kept for compatibility; not the primary) ---
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=
# LLM_MODEL=mistral-small-latest

# --- Container stack (docker compose) ---------------------------------------
# Development only. Never commit a real .env file.

APP_ENV=development
MOCK_MODE=true
LOG_LEVEL=INFO
API_PREFIX=/v1

# "inline" keeps the stack database-free. "database" requires DATABASE_URL.
JOB_BACKEND=inline
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/trend_detective

# Host ports published by compose.yaml
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Optional services (not part of the baseline stack) ---------------------
# Only meaningful once a real RAG / ML HTTP service exists. See
# compose.optional.example.yaml and docs/DOCKER.md.
# RAG_URL=http://rag:8001
# ML_SERVICE_URL=http://ml:8002
# MODEL_DIR=./models

# --- Production deployment (Azure VM) ---------------------------------------
# These are NON-SECRET defaults. Real values live in /opt/trend-detective/.env
# on the server and are never committed.
# APP_ENV=production
# MOCK_MODE=true
# FRONTEND_PORT=80
# BACKEND_PORT=8000
# CORS_ORIGINS=http://172.174.114.48
# Image references are injected by the deploy workflow, never edited by hand:
# BACKEND_IMAGE=ghcr.io/owner/repo/backend:sha-<commit>
# FRONTEND_IMAGE=ghcr.io/owner/repo/frontend:sha-<commit>
